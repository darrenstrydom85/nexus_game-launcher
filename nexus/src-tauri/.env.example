# Twitch OAuth credentials — baked into the binary at compile time.
# Copy this file to .env and fill in your values from https://dev.twitch.tv/console
NEXUS_TWITCH_CLIENT_ID=your_twitch_client_id_here
# Optional: only needed for confidential (server-side) apps. Omit for public PKCE flow.
# NEXUS_TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Updater signing (release builds only). Sign update artifacts so the updater
# plugin trusts them. Provide ONE of KEY or KEY_PATH, plus the password if set.
# Generate a keypair with: npm run tauri signer generate -- -w <path>
# TAURI_SIGNING_PRIVATE_KEY='contents_of_your_private_key'
# TAURI_SIGNING_PRIVATE_KEY_PATH='E:\path\to\nexus_updater.key'
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD='your_key_password_if_any'
